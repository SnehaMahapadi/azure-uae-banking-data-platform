{
	"name": "pl_master_daily",
	"properties": {
		"activities": [
			{
				"name": "run_reference",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_ingest_reference_data",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "run_transactions",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "run_reference",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_ingest_transactions",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"month": {
							"value": "@pipeline().parameters.month",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "run_gold_build",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "run_transactions",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Shared/uae-banking/20_gold_build"
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"month": {
				"type": "string",
				"defaultValue": "01"
			}
		},
		"annotations": []
	}
}